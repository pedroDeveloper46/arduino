void telaAjusteSet(){

  if(!ajustaSet) {
    lcd.clear(); //Apaga todos os caracteres do Display
    lcd.setCursor(0,0);//Marca o cursor na posição coluna 0, linha 0
    lcd.print("Ajuste o SP");//Escreve a mensagem a partir da posição coluna 0, linha 0
    lcd.setCursor(0,1);//Marca o cursor na posição coluna 0, linha 1
    lcd.print("SP:");//Escreve a mensagem a partir da posição coluna 0, linha 1
    lcd.print(setPoint);//Escreve o valor do set point
    ajustaSet=true;
  }
  else {
    lcd.setCursor(0,1);
    lcd.print("SP:");
    lcd.print(setPoint);
    if(digitalRead(botaoSetaBaixo) == HIGH && digitalRead(botaoSetaCima) == LOW) {
      setPoint = setPoint - 10;  
    }
    else if(digitalRead(botaoSetaBaixo) == LOW && digitalRead(botaoSetaCima) == HIGH) {
      setPoint = setPoint + 10;
    }
      delay(100);
    }

}

void telaAjusteHisterese() {

    if(!ajustaHisterese){
        lcd.clear(); //Apaga todos os caracteres do Display
        lcd.setCursor(0,0);//Marca o cursor na posição coluna 0, linha 0
        lcd.print("Ajuste a His");//Escreve a mensagem a partir da posição coluna 0, linha 0
        lcd.setCursor(0,1);//Marca o cursor na posição coluna 0, linha 1
        lcd.print("His: ");//Escreve a mensagem a partir da posição coluna 0, linha 1
        lcd.print(histerese);//Escreve o valor do set point
        ajustaHisterese=true;
    }
    else {
        lcd.setCursor(0,1);
        lcd.print("His:");
        lcd.print(histerese);
        if(digitalRead(botaoSetaBaixo) == HIGH && digitalRead(botaoSetaCima) == LOW) {
            histerese = histerese - 1;  
        }
        else if(digitalRead(botaoSetaBaixo) == LOW && digitalRead(botaoSetaCima) == HIGH) {
            histerese = histerese + 1;
        }
        delay(100);
    }
}



void telaControlandoTemperatura(){

    if(meuTermopar.readCelsius() <setPoint-histerese){
        lcd.clear();
        digitalWrite(solenoide2,LOW);
        lcd.print(String("SP ") + String(setPoint) + String(" OUT ON"));
    }else{
        lcd.clear();
        digitalWrite(solenoide2,HIGH);
        lcd.print(String("SP ") + String(setPoint) + String(" OUT OFF"));
    }

    if(!controlando){
        lcd.clear();
        if(digitalRead(solenoide2) == LOW){
            lcd.print(String("SP ") + String(setPoint) + String(" OUT ON"));
        }else{
            lcd.print(String("SP ") + String(setPoint) + String(" OUT OFF"));
        }

        controlando=true;
    }

}

bool verificaTemp(){

    float tempC = mostrarTemp2();

    if(tempC > 29){
        return false;
    }else{
        return true;
    }
}

void mostrarTemp() {
    lcd.init(); // INICIA A COMUNICAÇÃO COM O DISPLAY
    lcd.backlight(); // LIGA A ILUMINAÇÃO DO DISPLAY
    lcd.setCursor(9, 1);
    lcd.print(meuTermopar.readCelsius());
    lcd.println("C ");
  }

  float mostrarTemp2() {
      float tempC = meuTermopar.readCelsius();
      lcd.setCursor(5, 1);
      lcd.print("Temp: ");
      lcd.print(tempC);
      lcd.print(" C");
      delay(1000);
      return tempC;
    }

void ligarEquipamento() {
  if (!borboleta){
      lcd.setCursor(0, 0); // LIMPA O DISPLAY
      lcd.print("Asu Combustao");
      lcd.print("               ");
      mostrarTemp2();
      delay(tmp);
      lcd.setCursor(0, 0); // LIMPA O DISPLAY
      lcd.print("Ligando Motor");
      lcd.print("               "); 
      mostrarTemp2();
      digitalWrite (motor,LOW);
      delay (tmp);
      lcd.setCursor(0, 0); // LIMPA O DISPLAY
      lcd.print("Ignicao");
      lcd.print("               "); // LIMPA O DISPLAY
      mostrarTemp2();
      digitalWrite (ignicao,LOW);
      delay (tmp);
      lcd.setCursor (0, 0); // LIMPA O DISPLAY
      
      lcd.print("Fogo baixo");
      lcd.print("               "); // LIMPA O DISPLAY
      mostrarTemp2();
      digitalWrite (solenoide,LOW);
      delay(tmp);
      borboleta = true;
      
    
    }
  }
void falhaChama() {
    digitalWrite (motor,HIGH);
    digitalWrite (solenoide,HIGH);
    digitalWrite (solenoide2,HIGH);
    lcd.setCursor(0, 0); // LIMPA O DISPLAY
    lcd.print("Falha de chama");
    lcd.print("               ");
}

void chamaAcesa() {

  
  if (!afterLoopSetupDone) {
    digitalWrite (ignicao,HIGH);

    if (verificaTemp()){
        digitalWrite (solenoide2,LOW); // LIMPA O DISPLAY
        lcd.setCursor(0, 0);
     // LIMPA O DISPLAY
        lcd.print("Fogo alto");
        lcd.print("               ");
        delay(tmp);
        lcd.setCursor(0, 0);
        lcd.print("Chama acesa");
        lcd.print("               ");
        lcd.clear();
        
    }
    afterLoopSetupDone = true;
  }
}

void leituraPino(){ 

  int ldrValue;

  unsigned long startMillis = millis();
  while(millis() - startMillis < 3000) { // Fica em loop por 2 segundos

    ldrValue = digitalRead(ldr_pin);

    if(ldrValue == HIGH) { // Considera que a leitura HIGH indica escuridão
      digitalWrite (motor,HIGH);
      digitalWrite (solenoide,HIGH);
      digitalWrite (solenoide2,HIGH);
      digitalWrite(ignicao, HIGH);
      //lcd.setCursor(0, 0); // POSICIONA O CURSOR NA PRIMEIRA COLUNA DA LINHA 1
      //lcd.print("Falha de chama");
      isFinish = true;
      break;
  // put your main code here, to run repeatedly:
    }else{
      
      if(!isFinish){
        chamaAcesa();
      }
    }
  }
  
}

void resetScreen() {
  
  ajustaSet = false;
  
}
