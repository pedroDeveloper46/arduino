  unsigned long startMillis = millis();
  while(millis() - startMillis < 2000) { // Fica em loop por 2 segundos

    ldrValue = digitalRead(ldr_pin);

    if(ldrValue == HIGH) { // Considera que a leitura HIGH indica escuridão
      digitalWrite (motor,HIGH);
      digitalWrite (solenoide,HIGH);
      digitalWrite (solenoide2,HIGH);
      lcd.setCursor(0, 0); // POSICIONA O CURSOR NA PRIMEIRA COLUNA DA LINHA 1
      lcd.print("Falha de chama");
      isFinish2 = true;
      break;
  // put your main code here, to run repeatedly:
    }

    

  }
}
