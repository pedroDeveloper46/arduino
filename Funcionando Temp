#include <Wire.h>
#include <LiquidCrystal_I2C.h>
#include "max6675.h"

#define endereco  0x3F // Endereços comuns: 0x27, 0x3F
#define colunas   16
#define linhas    2
#define motor 7
#define ignicao 6
#define tmp 3000
#define solenoide 4
#define solenoide2 3
#define botaoAjuste 11
#define botaoSetaCima 12
#define botaoSetaBaixo 13


const int ldr_pin = 5;
int thermoDO = 8;
int thermoCS = 9;
int thermoCLK = 10;
bool borboleta = false;
bool afterLoopSetupDone = false;
bool porcelana = false;
bool barcelona = false;
float tempC;
int ldrValue;
bool isFinish = false;
bool isFinish2 = false;

int setPoint = 40; //setPoint é a temperatura que desejamos atingir com o nosso controlador
int histerese = 10; //histerese é um atraso no acionamento da saída do controlador


bool telaInit = false;
bool ajustaSet = false;
bool ajustaHisterese = false;
bool controlando = false;

int telas = 0; //telaInit = 0, telaControle = 1, telaAjustaSet = 2, telaAjustaHisterese = 4


LiquidCrystal_I2C lcd(endereco, colunas, linhas);
MAX6675 meuTermopar(thermoCLK, thermoCS, thermoDO);

void setup() {
  // put your setup code here, to run once:
  pinMode(botaoAjuste,INPUT);
  pinMode(botaoSetaBaixo,INPUT);
  pinMode(botaoSetaCima,INPUT);
  pinMode (motor,OUTPUT);
  pinMode (ignicao,OUTPUT);
  pinMode (ldr_pin,INPUT);
  pinMode (solenoide,OUTPUT);
  pinMode (solenoide2,OUTPUT);
  digitalWrite (ignicao,HIGH);
  digitalWrite (solenoide,HIGH);
  digitalWrite (solenoide2,HIGH);
  digitalWrite (motor,HIGH);
  pinMode(thermoCS, OUTPUT);
  digitalWrite(thermoCS, HIGH);
  lcd.init(); // INICIA A COMUNICAÇÃO COM O DISPLAY
  lcd.backlight(); // LIGA A ILUMINAÇÃO DO DISPLAY
  ligarEquipamento();

}

void loop() {
  // put your main code here, to run repeatedly:
  
      tempC = mostrarTemp2();
      leituraPino();
      //alternanciaTemperatura();
      verificaFogo();
      alternanciaTemperatura();
        
      
}

